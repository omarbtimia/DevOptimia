# Motor usado por la aplicación: sqlite (por defecto) o aurora/dsql.
# Si DB_DRIVER está vacío, Aurora se activa automáticamente cuando AURORA_DSQL_HOST existe.
DB_DRIVER=sqlite

# Nombre del archivo SQLite dentro de ./data (se crea automáticamente).
SQLITE_PATH=optimia.sqlite

# Aurora DSQL (solo cuando DB_DRIVER=aurora o cuando se define AURORA_DSQL_HOST).
# El proceso usa la cadena de credenciales estándar de AWS (env, AWS profile o IAM role).
AURORA_DSQL_HOST=
AURORA_DSQL_REGION=
AURORA_DSQL_DATABASE=postgres
AURORA_DSQL_PORT=5432
AURORA_DSQL_CRUD_USER=optimia_crud
AURORA_DSQL_READ_USER=optimia_read
AURORA_DSQL_POOL_MAX=8
AURORA_DSQL_TOKEN_EXPIRES_IN=900
AURORA_DSQL_TOKEN_TTL=780

# Solo para `npm run db:init:aurora`: ARNs de los roles IAM mapeados a los roles DB.
AURORA_DSQL_READ_IAM_ROLE_ARN=
AURORA_DSQL_CRUD_IAM_ROLE_ARN=

# Token de AWS Bedrock para el chat de Líderes (opcional).
AWS_BEARER_TOKEN_BEDROCK=
