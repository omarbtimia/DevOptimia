# Aurora DSQL: la app siempre usa PostgreSQL sobre DSQL (sin SQLite).
AURORA_DSQL_HOST=pega-aqui-el-endpoint.dsql.us-east-1.on.aws
AURORA_DSQL_REGION=us-east-1
AURORA_DSQL_DATABASE=postgres
AURORA_DSQL_PORT=5432
AURORA_DSQL_CRUD_USER=optimia_crud
AURORA_DSQL_READ_USER=optimia_read
AURORA_DSQL_POOL_MAX=8
AURORA_DSQL_TOKEN_EXPIRES_IN=900
AURORA_DSQL_TOKEN_TTL=780

# Solo para npm run db:init:aurora con identidad DbConnectAdmin.
AURORA_DSQL_READ_IAM_ROLE_ARN=pega-aqui-el-arn-del-role-read
AURORA_DSQL_CRUD_IAM_ROLE_ARN=pega-aqui-el-arn-del-role-crud

# Token de AWS Bedrock para el chat de Líderes (opcional).
AWS_BEARER_TOKEN_BEDROCK=

# OAuth 2.0 de Google (obligatorio para "Continuar con Google").
GOOGLE_CLIENT_ID=pega-aqui-el-client-id
GOOGLE_CLIENT_SECRET=pega-aqui-el-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
